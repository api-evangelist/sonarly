    "_postman_id": "340e41ed-a901-4a78-b07e-01d5c046c021",
    "name": "Sonarly Bugs Setup API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Sonarly turns noisy production alerts into clear, deduplicated bug reports and ships fix pull requests. It connects to a team's code (GitHub/GitLab) and their error/observability stack (Sentry, Datadog, Grafana, and more), then triages, root-causes and fixes alerts automatically. This API covers two surfaces: the read-only public REST API (v1) for pulling bugs, incidents and analysis runs into your own dashboards, and the device-code style setup-session API used to onboard a tenant.\n\nContact Support:\n Name: Sonarly",
      "type": "text/plain"
    }
  }
